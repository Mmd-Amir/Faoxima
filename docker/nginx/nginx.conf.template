map $http_x_request_id $faoxima_request_id {
    ~^[A-Za-z0-9._-]{8,80}$ $http_x_request_id;
    default $request_id;
}

log_format faoxima_timing escape=json '{"ts":"$time_iso8601","request_id":"$faoxima_request_id","method":"$request_method","uri":"$uri","status":$status,"bytes":$body_bytes_sent,"request_time":$request_time,"upstream_connect_time":"$upstream_connect_time","upstream_header_time":"$upstream_header_time","upstream_response_time":"$upstream_response_time","upstream_status":"$upstream_status"}';

server {
    listen 80;
    server_name ${DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    server_tokens off;
    index index.php;
    access_log /var/log/faoxima/nginx-performance.log faoxima_timing;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    client_max_body_size 116M;
    keepalive_timeout 65s;
    gzip on;
    gzip_types application/json text/plain;
    add_header X-Request-ID $faoxima_request_id always;

    location ~ /\.(?!well-known).* {
        deny all;
        return 404;
    }

    location /phpmyadmin/ {
        allow 127.0.0.1;
        allow ::1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;

        proxy_pass http://phpmyadmin:80/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    include /etc/nginx/conf.d/bots/*.conf;

    location / {
        return 404;
    }
}

